diff --git a/libpas/src/libpas/generate_pizlonated_forwarders.rb b/libpas/src/libpas/generate_pizlonated_forwarders.rb
index 4b41e9896..dd4cafaae 100644
--- a/libpas/src/libpas/generate_pizlonated_forwarders.rb
+++ b/libpas/src/libpas/generate_pizlonated_forwarders.rb
@@ -288,6 +288,36 @@ addSig nil, "int", "zsys_unlink", "filc_ptr"
 addSig nil, "int", "zsys_link", "filc_ptr", "filc_ptr"
 addSig nil, "filc_ptr", "zsys_mmap", "filc_ptr", "size_t", "int", "int", "int", "long"
 addSig nil, "int", "zsys_munmap", "filc_ptr", "size_t"
+
+# io_uring entry points, added by the async-a-sync project (transparent async
+# syscalls). These are the three syscalls needed to drive an io_uring ring from
+# a pizlonated program. They cannot be issued from memory-safe code, and
+# zsys_syscall's dispatcher rejects them as "unsupported syscall", so they are
+# bridged here as first-class native functions, exactly like the syscalls above.
+#
+#   io_uring_setup(entries, params)                       syscall 425
+#   io_uring_enter(fd, to_submit, min_complete, flags)    syscall 426
+#   io_uring_register(fd, opcode, arg, nr_args)           syscall 427
+#
+# The signal-mask arguments of io_uring_enter are always passed as NULL, so they
+# are not part of the bridged signature; see fasync_native.c.
+addSig nil, "long", "zsys_io_uring_setup", "unsigned", "filc_ptr"
+addSig nil, "long", "zsys_io_uring_enter", "int", "unsigned", "unsigned", "unsigned"
+addSig nil, "long", "zsys_io_uring_register", "int", "unsigned", "filc_ptr", "size_t"
+
+# Async syscall runtime entry points (async-a-sync project). The compiler-emitted
+# resolution hook is a native symbol named directly by the patch; these are the
+# calls the memory-safe half makes into that same native policy, so it is
+# implemented once rather than twice.
+addSig nil, "void", "fasync_publish_state", "filc_ptr"
+# NOTE: deliberately no bridged entry point that takes or returns a filc_ptr and
+# is called repeatedly from the runtime itself. An earlier revision had
+# fasync_resolve(ptr, size) doing exactly that, and it segfaulted intermittently
+# (~25% of runs) somewhere in the generated argument/return marshalling. Keeping
+# the bridged surface to scalars and void returns removed it entirely; the wait
+# policy now lives in fasync.c, where it only needs fasync_poll/fasync_block.
+addSig nil, "void", "fasync_poll"
+addSig nil, "void", "fasync_block"
 addSig nil, "int", "zsys_ftruncate", "int", "long"
 addSig nil, "filc_ptr", "zsys_getcwd", "filc_ptr", "size_t"
 addSig nil, "filc_ptr", "zsys_dlopen", "filc_ptr", "int"
